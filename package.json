{
  "name": "projet-booking",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "test:all": "yarn test && yarn test:integration",
    "build": "yarn workspace @booking/webapp build",
    "typecheck": "tsc --noEmit && yarn workspace @booking/webapp exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1",
    "@types/express": "^4",
    "@types/node": "^22",
    "@types/pg": "^8",
    "@types/supertest": "^6",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
