# Copiez ce fichier en .env et adaptez-le.
# Aucun secret dans le dépôt : ni .env versionné, ni clé dans un fichier de
# configuration. Et un secret exposé est un secret RÉVOQUÉ — pas "supprimé
# du commit" : git garde l'historique, et les robots sont plus rapides que vous.

PORT=3000
DATABASE_URL=postgres://postgres:secret@localhost:55432/booking
PUBLIC_URL=http://localhost:5173
SMTP_URL=log://
MAIL_FROM=no-reply@booking.example
LOG_LEVEL=info

# USE_MEMORY=1 fait tourner le domaine sans base de données :
# pratique pour une démo, et c'est ce qu'utilisent les tests de bout en bout.
# USE_MEMORY=1
